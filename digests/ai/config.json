{
  "digest": {
    "name": "The AI Daily Roundup",
    "tagline": "AI DIGEST",
    "emoji": "⚡",
    "tone": "informed, direct, slightly opinionated",
    "max_articles": 20
  },
  "categories": [
    {
      "id": "model-release",
      "label": "Model Releases",
      "emoji": "🚀",
      "description": "Major new models or capability upgrades (GPT/Claude/Gemini releases, benchmark improvements, reasoning models, multimodal upgrades)"
    },
    {
      "id": "dev-tools",
      "label": "Developer Tools",
      "emoji": "🛠️",
      "description": "Tools that help people build AI systems (Claude Code, OpenClaw, LangChain, MCP tools, agent frameworks, coding copilots)"
    },
    {
      "id": "infra-platform",
      "label": "Infrastructure & Platforms",
      "emoji": "🏗️",
      "description": "Infrastructure for deploying AI (inference engines, GPU infrastructure, vector databases, model hosting, AI cloud platforms)"
    },
    {
      "id": "research",
      "label": "Research & Techniques",
      "emoji": "🔬",
      "description": "Papers or new technical approaches (agent architectures, reasoning techniques, training methods, evaluation methods)"
    },
    {
      "id": "applications",
      "label": "Applications & Products",
      "emoji": "📱",
      "description": "AI applied to real-world products (new AI apps, consumer tools, enterprise deployments, AI assistants)"
    },
    {
      "id": "industry",
      "label": "Industry & Business",
      "emoji": "💼",
      "description": "Market moves and ecosystem changes (funding rounds, partnerships, regulation, company strategy)"
    },
    {
      "id": "other",
      "label": "Other",
      "emoji": "🌐",
      "description": "Anything that doesn't fit the above categories"
    }
  ],
  "podcast": {
    "enabled": true,
    "name": "The AI Daily Roundup",
    "description": "Trying to keep up with AI without drowning in it? The AI Daily Roundup is your daily catch-up on everything that matters — delivered every morning. Each episode walks through the day's biggest model releases and capability upgrades, the developer tools and agent frameworks worth knowing about, new research and techniques, the infrastructure powering it all, real-world product launches, and the funding, partnerships, and strategy moves driving the industry. The technical depth when it matters, the big-picture context when it counts — smart, fast, and no filler. New episodes daily, also available as an email digest at aidailyroundup.com. Hosted by AI, curated for humans.",
    "image_url": "https://aidailyroundup.com/ai-podcast-logo.jpg",
    "owner": {
      "name": "The AI Daily Roundup",
      "email": "mwoolley2@gmail.com"
    },
    "hosts": [
      {
        "tag": "ALEX",
        "role": "The technical host. Digs into architecture, benchmarks, and implementation details. Enthusiastic about engineering breakthroughs.",
        "voice_kokoro": "am_michael"
      },
      {
        "tag": "SARAH",
        "role": "The big-picture host. Focuses on strategy, industry impact, and what it means for practitioners. Asks the \"so what?\" questions.",
        "voice_kokoro": "af_heart"
      }
    ],
    "tts_backend": "kokoro",
    "pronunciation": {
      "terms": {
        "AWS": "[AWS](/eɪdʌbəljuːɛs/)",
        "LLM": "[LLM](/ɛlɛlɛm/)",
        "LLMs": "[LLMs](/ɛlɛlɛmz/)",
        "GPT": "[GPT](/dʒiːpiːtiː/)",
        "API": "[API](/eɪpiːaɪ/)",
        "APIs": "[APIs](/eɪpiːaɪz/)",
        "GPU": "[GPU](/dʒiːpiːjuː/)",
        "GPUs": "[GPUs](/dʒiːpiːjuːz/)",
        "TPU": "[TPU](/tiːpiːjuː/)",
        "MCP": "EM-see-pee",
        "RAG": "[RAG](/ɹæɡ/)",
        "RLHF": "ar-ell-aych-eff",
        "SOTA": "state of the art",
        "OSS": "open source",
        "CLI": "see-ell-eye",
        "SDK": "ess-dee-kay",
        "SDKs": "ess-dee-kays"
      },
      "regex": [
        {
          "pattern": "\\$([0-9]+)B\\b",
          "replacement": "$1 billion dollars"
        },
        {
          "pattern": "\\$([0-9]+)M\\b",
          "replacement": "$1 million dollars"
        },
        {
          "pattern": "\\bQ([1-4])\\b",
          "replacement": "quarter $1"
        }
      ]
    }
  },
  "delivery": {
    "email": {
      "method": "resend",
      "resend": {
        "api_key_env": "RESEND_API_KEY",
        "from": "The AI Daily Roundup <digest@aidailyroundup.com>"
      }
    },
    "notify": {
      "method": "telegram",
      "telegram": {
        "bot_token_env": "TELEGRAM_BOT_TOKEN",
        "chat_id_env": "TELEGRAM_CHAT_ID"
      }
    }
  },
  "subscriptions": {
    "public_base_url": "https://aidailyroundup.com",
    "cors_origins": [
      "https://aidailyroundup.com",
      "https://ai-digest.duckdns.org"
    ],
    "port": 5100
  },
  "llm": {
    "provider": "openrouter"
  },
  "archive": {
    "enabled": true,
    "push": true,
    "branch": "master",
    "commit_message": "Daily archive: {date}",
    "artifacts": [
      "{date}.md",
      "podcasts/{date}.mp3",
      "podcasts/{date}.txt",
      "podcast.xml",
      "index.html",
      ".seen_embeddings.json"
    ]
  },
  "sources": {
    "twitter": {
      "accounts": [
        "claudeai",
        "openclaw",
        "bcherny",
        "adocomplete",
        "dejavucoder",
        "simonw",
        "karpathy",
        "MistralAI",
        "AnthropicAI",
        "googleaistudio",
        "googleai",
        "swyx",
        "openai",
        "googledeepmind",
        "AIatMeta",
        "cursor_ai",
        "openaidevs",
        "langchain"
      ],
      "lookback": "36h",
      "max_per_account": 8,
      "discovery": {
        "enabled": true,
        "keywords": [
          "Claude Code",
          "MCP server",
          "AI coding agent",
          "agent framework",
          "LangChain",
          "LLM evaluation",
          "AI infrastructure",
          "retrieval augmented generation"
        ],
        "tweets_per_keyword": 50,
        "min_followers": 5000,
        "min_posts_per_week": 1.0,
        "top_n": 10,
        "score_weights": {
          "followers": 2.0,
          "post_frequency": 0.0,
          "engagement": 0.3,
          "llm_score": 2.0
        },
        "llm_filter": {
          "enabled": true,
          "evaluate_top_n": 30,
          "min_relevance": 6
        }
      }
    },
    "newsletters": {
      "imap": {
        "host": "imap.gmail.com",
        "email": "mwoolley2@gmail.com"
      },
      "sources": {
        "rundown_ai": {
          "name": "The Rundown AI",
          "from": "news@daily.therundown.ai",
          "lookback_days": 1
        }
      }
    },
    "blogs": {
      "simon_willison": {
        "name": "Simon Willison",
        "feed_url": "https://simonwillison.net/atom/everything/",
        "description": "AI/LLM thinker — prompt engineering, agent patterns, tooling"
      },
      "bens_bites": {
        "name": "Ben's Bites",
        "feed_url": "https://www.bensbites.com/feed",
        "description": "Daily AI news roundup — model releases, dev tools, ecosystem",
        "stale_after_days": 5
      },
      "the_ai_engineer": {
        "name": "The AI Engineer",
        "feed_url": "https://theaiengineer.substack.com/feed",
        "description": "Deep technical explainers on AI engineering — MCP, agents, coding tools",
        "stale_after_days": 7
      },
      "latent_space": {
        "name": "Latent Space",
        "feed_url": "https://www.latent.space/feed",
        "description": "Deep AI engineering commentary and ecosystem analysis",
        "stale_after_days": 5
      },
      "one_useful_thing": {
        "name": "One Useful Thing",
        "feed_url": "https://www.oneusefulthing.org/feed",
        "description": "Practical AI research and usage insights",
        "stale_after_days": 45
      },
      "openai_blog": {
        "name": "OpenAI Blog",
        "feed_url": "https://openai.com/blog/rss.xml",
        "description": "Model releases and product launches",
        "stale_after_days": 7
      },
      "google_ai_blog": {
        "name": "Google AI Blog",
        "feed_url": "https://blog.google/technology/ai/rss/",
        "description": "Gemini and DeepMind updates",
        "stale_after_days": 14
      },
      "huggingface_blog": {
        "name": "Hugging Face Blog",
        "feed_url": "https://huggingface.co/blog/feed.xml",
        "description": "Open-source models and ecosystem tools",
        "stale_after_days": 7
      },
      "the_new_stack": {
        "name": "The New Stack",
        "feed_url": "https://thenewstack.io/feed/",
        "description": "AI infrastructure and developer ecosystem"
      }
    },
    "github_trending": {
      "name": "GitHub Trending",
      "url": "https://github.com/trending?since=weekly",
      "min_stars_week": 200,
      "ai_keywords": [
        "ai",
        "llm",
        "agent",
        "rag",
        "mcp",
        "transformer"
      ]
    }
  },
  "relevance_filter": {
    "enabled": true,
    "topic": "artificial intelligence, machine learning, and AI products",
    "keywords_include": [
      "AI",
      "LLM",
      "GPT",
      "Claude",
      "Anthropic",
      "OpenAI",
      "agent",
      "agents",
      "model",
      "inference",
      "training",
      "fine-tuning",
      "embedding",
      "multimodal",
      "copilot",
      "GPU",
      "MCP",
      "RAG",
      "Meta",
      "Muse",
      "OpenClaw"
    ],
    "keywords_exclude": [
      "sports",
      "weather",
      "horoscope",
      "fashion",
      "travel"
    ],
    "borderline_llm": true
  }
}
